    "react_import_solid": "import { UserIcon, LockClosedIcon, Cog6ToothIcon } from 'heroicons/24/solid'",
    "react_usage": "<UserIcon className=\"w-6 h-6 text-blue-500\" />",
    "svg_inline": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" class=\"w-6 h-6\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M...\" /></svg>",
    "tailwind_classes": "w-4, w-5, w-6, h-4, h-5, h-6 for sizing",
    "color_via_tailwind": "text-blue-500, text-red-600, text-green-400, etc",
    "css_currentcolor": "Uses currentColor by default - apply color via CSS class or style attribute"
  },
